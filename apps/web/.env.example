# NextSpot 프론트엔드 환경변수 (apps/web) — 로컬 전용
# 실제 값은 apps/web/.env.local 에 넣는다(gitignore). NEXT_PUBLIC_ 접두는 브라우저 번들에 포함된다.

# --- Supabase (주 데이터/인증) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Kakao Maps SDK (지도) ---
# 코드는 NEXT_PUBLIC_KAKAO_MAPS_APP_KEY → NEXT_PUBLIC_KAKAO_API_KEY → NEXT_PUBLIC_KAKAO_MAP_KEY 순으로 폴백한다.
NEXT_PUBLIC_KAKAO_MAPS_APP_KEY=your-kakao-maps-app-key
# (선택) 도보/차량 실거리 길찾기. 미설정 시 직선거리 환산 폴백.
NEXT_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key

# --- 백엔드(FastAPI) ---
# 로컬 백엔드 주소. 미설정 시 http://localhost:8000 기본값.
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000

# Open Graph/Twitter 공유 이미지의 절대 URL 기준. 운영 도메인으로 설정합니다.
NEXT_PUBLIC_SITE_URL=https://nextspot-nu.vercel.app

# --- 관리자/사장님 콘솔 ---
# 설정할 env 가 없다. 두 콘솔 모두 **앱 계정 로그인 + users.role** 로 들어간다.
#
# 예전에는 여기에 NEXT_PUBLIC_ADMIN_PASSWORD / NEXT_PUBLIC_MERCHANT_PASSWORD 와
# NEXT_PUBLIC_*_API_TOKEN 이 있었다. NEXT_PUBLIC_ 은 정적 번들에 그대로 들어가므로
# 비밀번호도 토큰도 브라우저에서 그냥 읽혔고, 검사가 클라이언트에서 일어나 콘솔에서
# localStorage 플래그 한 줄이면 통과했다 — 실제 보안 경계가 아니었다.
# 이제 권한은 서버가 매 요청 users.role 과 facility_owners 로 판정한다.
# (프런트 판정은 lib/account.tsx 하나, 실제 차단은 apps/api/app/core/authz.py)
#
# ⚠️ 서비스 토큰(SERVICE_API_TOKEN)을 여기에 NEXT_PUBLIC_ 으로 미러하지 말 것.
#    그 순간 스케줄러 토큰이 다시 공개된다.
