# 앱 공개 설정 — EXPO_PUBLIC_* 는 번들에 그대로 들어간다. 비밀값을 넣지 않는다.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 운영(production) 빌드에서만 1
EXPO_PUBLIC_USAGE_EVENTS=
# 웹 빌드(expo export --platform web) 지도 — 카카오 지도 JS 키(공개 키, 카카오 개발자 콘솔에서 웹 도메인으로 제한). 없으면 웹은 지도 없이 그린다.
EXPO_PUBLIC_KAKAO_MAP_KEY=
