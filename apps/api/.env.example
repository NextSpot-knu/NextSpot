# NextSpot API 환경변수 (apps/api) — 로컬 전용
# 복사: cp .env.example .env  후 Supabase 값 채우기.

# --- App Configuration ---
ENV=development
PROJECT_NAME="NextSpot API"

# --- Supabase Configuration (주 데이터 저장소) ---
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret: Supabase JWT 검증용 (Gotrue JWT Secret)
# Supabase Project settings -> API -> JWT Secret 에서 획득 가능
JWT_SECRET=your-supabase-jwt-secret

# --- 기계(스케줄러) 호출용 서비스 토큰 ---
# ⚠️ 사람의 관리자 인증이 아니다. 사람은 Supabase 로그인 + users.role 로 판정한다.
#    이 토큰은 세션을 가질 수 없는 호출자 — Supabase pg_cron, GitHub Actions — 가
#    /api/v1/area-demand/snapshots/collect 를 두드릴 때만 쓴다.
# ⚠️ 프런트엔드에 절대 넣지 말 것(NEXT_PUBLIC_* 금지 — 정적 번들에 그대로 박힌다).
# 공개 배포 시 반드시 강한 랜덤값으로 교체(예: openssl rand -hex 32).
#
# SERVICE_API_TOKEN 이 있으면 그것만 유효하고, 없으면 ADMIN_API_TOKEN 으로 폴백한다
# (배포된 Render/Actions/Vault 를 한꺼번에 바꾸지 않고 회전하기 위한 장치).
ADMIN_API_TOKEN=nextspot-admin-local
SERVICE_API_TOKEN=

# --- 폐지된 공유 토큰 (LEGACY_CONSOLE_TOKENS=true 일 때만 살아난다) ---
# 사장님 콘솔의 구 X-Merchant-Token 경로. 기본값 false 라 평소에는 아무 효과가 없다.
# 이 경로는 **사용자를 특정할 수 없어 가게 소유권을 확인하지 못한다** — 되살리지 말 것.
MERCHANT_API_TOKEN=nextspot-merchant-local
LEGACY_CONSOLE_TOKENS=false

# --- Kakao Local 장소 검색 (선택) ---
# 장소 ID·주소·좌표를 같은 Kakao 레코드로 검색한다. 도보 경로는 번들된 OSM 보행 그래프를 사용한다.
KAKAO_REST_API_KEY=

# --- LLM 보조 (선택 — Upstage Solar, OpenAI 호환 엔드포인트) ---
# 비어 있으면 LLM 보조 기능(음성 자유발화 해석·사유 다듬기·검색 재작성 등)만 조용히 비활성되고 결정적 경로로 동작한다.
UPSTAGE_API_KEY=
# LLM_BASE_URL=https://api.upstage.ai/v1
# LLM_MODEL=solar-pro3

# --- 관광 데이터 API ---
# 한국관광공사 TourAPI(공공데이터포털 B551011) 인증키 — 공모전 필수 데이터.
# POI 적재(scripts/ingest_tourapi.py)와 행사 조회에 사용.
TOURAPI_KEY=
# 기상청 단기예보 조회서비스(15084084) — 별도 자동승인 활용신청 후 받은 공공데이터포털 키.
KMA_API_KEY=
# 한국교통안전공단 주차정보 제공 API(15099883) — 비우면 TOURAPI_KEY를 재사용.
# 서비스 활용승인은 별도로 필요하지만 새 키를 만들 필요는 없다.
PARKING_API_KEY=
# 관광지 집중률(15128555)·연관 관광지(15128560)는 별도 활용신청 필요.
# 승인 후 같은 키로 scripts/ingest_tourism_insights.py를 실행한다.

# 경주 황리단길 기준좌표: 위도 35.8361 / 경도 129.2105 (scripts/ingest_tourapi.py 의 --lat/--lng 기본값)

# --- CORS Configuration ---
# 쉼표(,)로 구분된 허용 도메인 목록. 실제 도메인을 지정하면 해당 오리진만 허용 + credentials 활성(엄격 모드).
# "*" 또는 미설정이면 모든 오리진 허용(credentials 끔).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
