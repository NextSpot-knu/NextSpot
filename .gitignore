# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (루트·워크스페이스 어디든)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/apps/web/test-results/
/apps/web/playwright-report/

# next.js
.next/
out/
apps/web/out/
apps/web/.next/

# production
/build
build/

# misc / editors
.DS_Store
*.pem
.vscode/
.idea/

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc
*.pyo
*.pkl
*.egg-info/

# Python 가상환경 / 캐시
.venv/
venv/
.pytest_cache/
.ruff_cache/

# supabase cli temp
supabase/.temp/
scratch/

# AI 도구 로컬 상태 (지침 파일 AGENTS.md/CLAUDE.md 는 추적 대상)
.claude/
.codex/
.gemini/
.antigravity/

# Service-account/credential key files (never commit plaintext keys).
# Scoped to repo root so the broad dotted-JSON glob can't swallow nested config JSON that must stay tracked.
/*-*.json
# ↑ 글롭이 package-lock.json 까지 삼켜 루트 락파일이 커밋되지 않던 footgun 수정 —
#   CI(npm ci) 재현성을 위해 락파일은 반드시 추적한다.
!/package-lock.json

# Stray env files beyond the committed .example templates (belt-and-suspenders; .env* already ignored above)
*.env
!*.env.example
apps/api/scripts/tag_cuisines_report.json

# Obsidian 볼트 설정(로컬 편집 도구) — 저장소 공유 대상 아님
docs/.obsidian/
docs/MERCHANT_CONSOLE_RBAC_PLAN.md
